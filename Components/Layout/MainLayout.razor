@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UserState UserState
@inject CartState CartState
@implements IDisposable

<div class="page" @onclick="CloseMenu">
    <main>
        <div class="top-row px-3">
            <div class="layout-left">
                <NavLink class="back-button" href="/" Match="NavLinkMatch.All">
                    <span class="back-arrow" aria-hidden="true"></span>
					<span class="page-title">@GetPageTitle()</span>
                </NavLink>
            </div>

            @if (UserState.IsLoggedIn)
            {
                <div class="layout-right">
                    <div class="account-container">
                        <span class="account-name">@UserState.Username</span>
                        <div class="account-avatar" title="@UserState.Username">
                            @GetInitials(UserState.Username)
                        </div>
                    </div>

                    <div class="menu-container">
                        <button class="three-dots-button" type="button" @onclick:stopPropagation="true" @onclick="ToggleMenu" aria-label="Open menu" aria-expanded="@isMenuOpen">
							<span class="three-dots-vertical" aria-hidden="true"></span>
						</button>

                        @if (isMenuOpen)
                        {
                            <div class="dropdown-menu-custom shadow" @onclick:stopPropagation="true">
                                <button class="dropdown-item-custom" type="button" @onclick="HandleClearCart">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="menu-item-icon" viewBox="0 0 16 16">
                                        <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
                                    </svg>
                                    <span>Clear Cart</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <article>
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isMenuOpen;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UserState.OnStateChanged += OnUserStateChanged;
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void CloseMenu()
    {
        if (isMenuOpen)
        {
            isMenuOpen = false;
        }
    }

    private void HandleClearCart()
    {
        CartState.ClearCart();
        isMenuOpen = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private void OnUserStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetPageTitle()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();
        if (string.IsNullOrEmpty(relativePath))
        {
            return "Catalog";
        }

        var seg = relativePath.Split('?')[0].Split('#')[0].Trim('/');
        if (string.IsNullOrEmpty(seg)) return "Catalog";

        return char.ToUpper(seg[0]) + seg.Substring(1);
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        }
        return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[^1][0])}";
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        UserState.OnStateChanged -= OnUserStateChanged;
    }
}
